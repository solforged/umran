{
  "name": "umran",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run build:wasm && vite --host 127.0.0.1",
    "build:wasm": "wasm-pack build crates/umran-web --target web --out-dir ../../web/src/wasm --out-name umran_web",
    "check": "tsc --noEmit",
    "build": "bun run build:wasm && bun run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:core": "cargo test --workspace",
    "parity": "bun scripts/parity.ts",
    "brand": "bun brand/build.js",
    "test:web": "bun test tests"
  },
  "dependencies": {
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wasm-pack": "0.15.0"
  },
  "trustedDependencies": ["wasm-pack"]
}
